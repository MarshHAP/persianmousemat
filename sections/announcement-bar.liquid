{%- comment -%} Rotating announcement messages with a megaphone icon. {%- endcomment -%}
<div
  class="announcement-bar"
  style="--ab-bg: {{ section.settings.background }}; --ab-text: {{ section.settings.text_color }};"
  role="region"
  aria-label="{{ 'sections.announcement.label' | t }}"
>
  <div
    class="announcement-bar__track"
    data-announcement
    data-speed="{{ section.settings.speed }}"
  >
    {%- for block in section.blocks -%}
      <div class="announcement-bar__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="announcement-bar__link">{%- endif -%}
        {%- if section.settings.show_icon -%}{% render 'icon', icon: 'campaign' %}{%- endif -%}
        <p class="announcement-bar__message">
          {%- if block.settings.bold_text != blank -%}<strong>{{ block.settings.bold_text | escape }}</strong> {% endif -%}
          <span>{{ block.settings.text | escape }}</span>
        </p>
        {%- if block.settings.link != blank -%}</a>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement-bar",
  "max_blocks": 8,
  "settings": [
    { "type": "checkbox", "id": "show_icon", "label": "Show megaphone icon", "default": true },
    { "type": "range", "id": "speed", "min": 2, "max": 10, "step": 1, "unit": "s", "label": "Change every", "default": 4 },
    { "type": "color", "id": "background", "label": "Background", "default": "#5bbc05" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "bold_text", "label": "Bold text", "default": "WINTER SALE" },
        { "type": "text", "id": "text", "label": "Text", "default": "— 30% OFF" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [{ "type": "announcement" }]
    }
  ]
}
{% endschema %}
