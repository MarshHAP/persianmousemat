{%- comment -%}
  Top black bar: "SALE ENDS IN" + DD HH MM SS countdown.
  Evergreen by default (counts down to local midnight), or to a fixed end date.
{%- endcomment -%}
<div
  class="countdown-bar"
  style="--cb-bg: {{ section.settings.background }}; --cb-text: {{ section.settings.text_color }}; --cb-box: {{ section.settings.box_color }}; --cb-num: {{ section.settings.number_color }};"
>
  <div class="countdown-bar__inner">
    <div class="countdown-bar__text">{{ section.settings.text | escape }}</div>
    <div
      class="countdown-bar__timer"
      data-countdown
      data-end="{{ section.settings.end_date | escape }}"
      data-mode="{{ section.settings.mode }}"
    >
      <span class="countdown-bar__unit"><span data-unit="d">00</span></span>
      <span class="countdown-bar__unit"><span data-unit="h">00</span></span>
      <span class="countdown-bar__unit"><span data-unit="m">00</span></span>
      <span class="countdown-bar__unit"><span data-unit="s">00</span></span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Countdown bar",
  "class": "section-countdown-bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "WINTER SALE ENDS IN" },
    {
      "type": "select",
      "id": "mode",
      "label": "Countdown mode",
      "options": [
        { "value": "daily", "label": "Evergreen (resets every midnight)" },
        { "value": "date", "label": "Fixed end date" }
      ],
      "default": "daily"
    },
    { "type": "text", "id": "end_date", "label": "End date", "info": "Used with \"Fixed end date\". Format: 2026-12-31 23:59" },
    { "type": "color", "id": "background", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#5bbc05" },
    { "type": "color", "id": "box_color", "label": "Number box color", "default": "#5bbc05" },
    { "type": "color", "id": "number_color", "label": "Number color", "default": "#000000" }
  ],
  "presets": [{ "name": "Countdown bar" }]
}
{% endschema %}
