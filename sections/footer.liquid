<footer class="footer" style="--ft-bg: {{ section.settings.background }};">
  <div class="page-width">
    <div class="footer__top">
      {%- for block in section.blocks -%}
        <div class="footer__block footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'link_list' -%}
              {%- if block.settings.heading != blank -%}<h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
              <ul class="footer__links" role="list">
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- when 'logo' -%}
              <a href="{{ routes.root_url }}" class="footer__logo" style="--fl-w: {{ block.settings.width }}px;">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: shop.name }}
                {%- elsif settings.logo != blank -%}
                  {{ settings.logo | image_url: width: 600 | image_tag: loading: 'lazy', alt: shop.name }}
                {%- else -%}
                  {% render 'logo-wordmark', dark: true %}
                {%- endif -%}
              </a>
            {%- when 'text' -%}
              {%- if block.settings.heading != blank -%}<h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
              <div class="footer__text rte">{{ block.settings.text }}</div>
              {%- if block.settings.show_social -%}{% render 'social-icons' %}{%- endif -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="footer__bottom">
    <div class="page-width">
      <div class="footer__bottom-row">
        <div class="footer__localization">
          {%- if section.settings.show_country and localization.available_countries.size > 1 -%}
            {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
              <h2 class="footer__caption">{{ 'localization.country_label' | t }}</h2>
              <div class="select">
                <select name="country_code" onchange="this.form.submit()" aria-label="{{ 'localization.country_label' | t }}">
                  {%- for country in localization.available_countries -%}
                    <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                      {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                    </option>
                  {%- endfor -%}
                </select>
                {% render 'icon', icon: 'caret' %}
              </div>
            {%- endform -%}
          {%- endif -%}
        </div>
        {%- if section.settings.show_payment -%}
          <ul class="footer__payment" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      <p class="footer__copyright"><small>&copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}</small></p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 4,
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#000000" },
    { "type": "checkbox", "id": "show_country", "label": "Show country/region selector", "default": true },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Customer Care" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "logo",
      "name": "Logo",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo (defaults to theme logo)" },
        { "type": "range", "id": "width", "min": 80, "max": 400, "step": 10, "unit": "px", "label": "Width", "default": 290 }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Our Mission" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell customers about your brand.</p>" },
        { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": false }
      ]
    }
  ]
}
{% endschema %}
