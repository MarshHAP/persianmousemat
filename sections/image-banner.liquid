<div class="image-banner" style="--ib-h: {{ section.settings.height }}px; --ib-hm: {{ section.settings.height_mobile }}px;">
  <div class="image-banner__media">
    {%- if section.settings.image != blank -%}
      {%- if section.settings.image_mobile != blank -%}
        <picture>
          <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1000 }}">
          {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', sizes: '100vw', widths: '750, 1100, 1500, 1920, 2400', alt: section.settings.image.alt }}
        </picture>
      {%- else -%}
        {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', sizes: '100vw', widths: '750, 1100, 1500, 1920, 2400', alt: section.settings.image.alt }}
      {%- endif -%}
    {%- else -%}
      <div class="image-banner__placeholder">
        <img src="{{ 'pm-placeholder-rug.svg' | asset_url }}" alt="" class="image-banner__ph-rug" width="900" height="400">
      </div>
    {%- endif -%}
  </div>
  {%- if section.settings.heading != blank or section.settings.button_label != blank -%}
    <div class="image-banner__content image-banner__content--{{ section.settings.position }}">
      <div class="image-banner__box">
        {%- if section.settings.heading != blank -%}<h2 class="image-banner__heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button image-banner__button">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Image banner",
  "class": "section-image-banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
    { "type": "range", "id": "height", "min": 300, "max": 900, "step": 10, "unit": "px", "label": "Desktop height", "default": 720 },
    { "type": "range", "id": "height_mobile", "min": 200, "max": 700, "step": 10, "unit": "px", "label": "Mobile height", "default": 420 },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Bring Persian Art To Your Desk" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "👉 CLAIM OFFER" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "position",
      "label": "Box position",
      "options": [
        { "value": "bottom", "label": "Bottom center" },
        { "value": "center", "label": "Center" }
      ],
      "default": "bottom"
    }
  ],
  "presets": [{ "name": "Image banner" }]
}
{% endschema %}
