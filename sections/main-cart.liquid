<div class="main-page">
  <div class="page-width" style="max-width: 900px;">
    <h1 class="main-page__title">{{ 'sections.cart.title' | t }}</h1>
    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="CartPageForm">
        <ul class="cart-page__items" role="list">
          {%- for item in cart.items -%}
            <li class="cart-item">
              <a href="{{ item.url }}" class="cart-item__image">
                {%- if item.image -%}{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.title }}{%- else -%}{% render 'image-or-placeholder', alt: '' %}{%- endif -%}
              </a>
              <div class="cart-item__details">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="cart-item__variant">{{ item.variant.title | escape }}</p>{%- endunless -%}
                {%- for discount in item.line_level_discount_allocations -%}
                  <p class="cart-item__discount">{% render 'icon', icon: 'tag' %} {{ discount.discount_application.title | escape }} (-{{ discount.amount | money }})</p>
                {%- endfor -%}
                <div class="cart-item__row">
                  <div class="quantity">
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'sections.cart.quantity' | t }}" style="width:60px">
                  </div>
                  <div class="cart-item__prices">
                    {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
                    <span>{{ item.final_line_price | money }}</span>
                  </div>
                </div>
              </div>
              <a href="{{ item.url_to_remove }}" class="cart-item__remove" aria-label="{{ 'sections.cart.remove' | t }}">{% render 'icon', icon: 'close' %}</a>
            </li>
          {%- endfor -%}
        </ul>
        <div class="cart-page__footer">
          {%- for discount in cart.cart_level_discount_applications -%}
            <p class="cart-item__discount">{% render 'icon', icon: 'tag' %} {{ discount.title | escape }} (-{{ discount.total_allocated_amount | money }})</p>
          {%- endfor -%}
          <p class="cart-drawer__subtotal" style="gap: 20px;"><span>{{ 'sections.cart.subtotal' | t }}</span> <strong>{{ cart.total_price | money_with_currency }}</strong></p>
          <p class="cart-drawer__note">{{ 'sections.cart.taxes' | t }}</p>
          <button type="submit" name="update" class="button" style="background:#fff;color:var(--text);border:1px solid rgba(var(--text-rgb),.3)">{{ 'sections.cart.update' | t }}</button>
          <button type="submit" name="checkout" class="button">{{ 'sections.cart.checkout' | t }}</button>
          <p class="secure-text secure-text--small">{% render 'icon', icon: 'lock' %} {{ 'sections.cart.secure' | t }}</p>
        </div>
      </form>
    {%- else -%}
      <div class="main-page--center">
        <p class="cart-drawer__empty-title" style="margin-bottom: 24px;">{{ 'sections.cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'general.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
