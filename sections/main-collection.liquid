<div class="main-page">
  <div class="page-width">
    <h1 class="main-page__title">{{ collection.title | escape }}</h1>
    {%- if collection.description != blank -%}<div class="rte" style="margin-bottom: 30px;">{{ collection.description }}</div>{%- endif -%}
    {%- paginate collection.products by section.settings.per_page -%}
      {%- if collection.products.size > 0 -%}
        <ul class="product-grid" role="list">
          {%- for card_product in collection.products -%}
            <li>{% render 'product-card', card_product: card_product %}</li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p>{{ 'sections.collection.empty' | t }}</p>
      {%- endif -%}
      {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection products",
  "settings": [
    { "type": "range", "id": "per_page", "min": 8, "max": 48, "step": 4, "label": "Products per page", "default": 16 }
  ]
}
{% endschema %}
