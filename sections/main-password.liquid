<div class="main-page main-page--center" style="max-width: 460px; padding: 40px 20px;">
  <div style="margin-bottom: 30px;">{% render 'logo-wordmark', dark: true %}</div>
  <h1 class="main-page__title" style="color:#fff;">{{ section.settings.heading | default: 'general.password_page.title' | t }}</h1>
  {%- if shop.password_message != blank -%}<p style="margin-bottom: 24px;">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password' -%}
    {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
    <input class="form-field" type="password" name="password" placeholder="{{ 'general.password_page.password' | t }}" aria-label="{{ 'general.password_page.enter_password' | t }}" autocomplete="current-password">
    <button type="submit" class="button button--full">{{ 'general.password_page.submit' | t }}</button>
  {%- endform -%}
  <p style="margin-top: 24px; font-size: 13px;">{{ 'general.password_page.admin' | t }} <a href="/admin" style="color: var(--accent);">{{ 'general.password_page.admin_link' | t }}</a></p>
</div>

{% schema %}
{
  "name": "Password",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading" }]
}
{% endschema %}
