{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id
  assign upsell = settings.upsell_product
  assign featured = product.featured_media

  comment
    Until the product has its own media, the gallery shows photos bundled
    with the theme (assets/pdp-NN.jpg). One per line: file | alt text.
  endcomment
  assign fallback_images = section.settings.fallback_images | strip | newline_to_br | split: '<br />'
  assign use_fallback = false
  if product.media.size == 0 and section.settings.fallback_images != blank
    assign use_fallback = true
  endif
-%}

<product-page
  class="product-section"
  data-section="{{ section.id }}"
  data-product-url="{{ product.url }}"
  data-money-format="{{ shop.money_format | escape }}"
>
  <div class="product page-width">
    {%- comment -%} ============ GALLERY ============ {%- endcomment -%}
    <div class="product__media-wrapper">
      <div class="product-gallery" data-gallery>
        <div class="product-gallery__viewport">
          <ul class="product-gallery__slides" role="list" data-gallery-slides>
            {%- if product.media.size > 0 -%}
              {%- for media in product.media -%}
                <li class="product-gallery__slide{% if media.id == featured.id %} is-active{% endif %}" data-media-id="{{ media.id }}" data-index="{{ forloop.index0 }}">
                  {%- case media.media_type -%}
                    {%- when 'video' or 'external_video' -%}
                      <div class="product-gallery__video">{{ media | media_tag: image_size: '1500x', autoplay: false, loop: true, controls: true }}</div>
                    {%- else -%}
                      {%- liquid
                        if forloop.first
                          assign ld = 'eager'
                        else
                          assign ld = 'lazy'
                        endif
                      -%}
                      {{ media.preview_image | image_url: width: 1500 | image_tag: loading: ld, sizes: '(min-width: 990px) 715px, 100vw', widths: '360, 535, 715, 1070, 1500', alt: media.alt, class: 'product-gallery__img' }}
                  {%- endcase -%}
                </li>
              {%- endfor -%}
            {%- elsif use_fallback -%}
              {%- for line in fallback_images -%}
                {%- liquid
                  assign parts = line | split: '|'
                  assign file = parts[0] | strip
                  assign alt = parts[1] | strip | default: product.title
                  assign base = file | split: '.' | first
                  if forloop.first
                    assign ld = 'eager'
                  else
                    assign ld = 'lazy'
                  endif
                -%}
                <li class="product-gallery__slide{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}">
                  <img
                    src="{{ file | asset_url }}"
                    srcset="{{ base | append: '-750.jpg' | asset_url }} 750w, {{ file | asset_url }} 1254w"
                    sizes="(min-width: 990px) 715px, 100vw"
                    width="1254"
                    height="1254"
                    alt="{{ alt | escape }}"
                    loading="{{ ld }}"
                    class="product-gallery__img"
                  >
                </li>
              {%- endfor -%}
            {%- else -%}
              <li class="product-gallery__slide is-active" data-index="0">
                {% render 'image-or-placeholder', class: 'product-gallery__img', alt: product.title, loading: 'eager' %}
              </li>
              <li class="product-gallery__slide" data-index="1">
                {% render 'image-or-placeholder', class: 'product-gallery__img', alt: product.title, placeholder: '2' %}
              </li>
            {%- endif -%}
          </ul>
          <button type="button" class="product-gallery__arrow product-gallery__arrow--mobile" data-gallery-next aria-label="{{ 'general.next' | t }}">{% render 'icon', icon: 'chevron-right' %}</button>
        </div>

        {%- if product.media.size > 1 or product.media.size == 0 -%}
          <div class="product-gallery__thumbs-wrap">
            <button type="button" class="product-gallery__thumb-arrow" data-thumbs-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', icon: 'chevron-left' %}</button>
            <div class="product-gallery__thumbs-viewport">
              <ul class="product-gallery__thumbs" role="list" data-gallery-thumbs>
                {%- if product.media.size > 0 -%}
                  {%- for media in product.media -%}
                    <li>
                      <button type="button" class="product-gallery__thumb{% if media.id == featured.id %} is-active{% endif %}" data-thumb-index="{{ forloop.index0 }}" aria-label="{{ 'products.product.media_thumb' | t: index: forloop.index }}">
                        {{ media.preview_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
                      </button>
                    </li>
                  {%- endfor -%}
                {%- elsif use_fallback -%}
                  {%- for line in fallback_images -%}
                    {%- assign base = line | split: '|' | first | strip | split: '.' | first -%}
                    <li>
                      <button type="button" class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-thumb-index="{{ forloop.index0 }}" aria-label="{{ 'products.product.media_thumb' | t: index: forloop.index }}">
                        <img src="{{ base | append: '-thumb.jpg' | asset_url }}" width="240" height="240" alt="" loading="lazy">
                      </button>
                    </li>
                  {%- endfor -%}
                {%- else -%}
                  <li><button type="button" class="product-gallery__thumb is-active" data-thumb-index="0">{% render 'image-or-placeholder', alt: '' %}</button></li>
                  <li><button type="button" class="product-gallery__thumb" data-thumb-index="1">{% render 'image-or-placeholder', alt: '', placeholder: '2' %}</button></li>
                {%- endif -%}
              </ul>
            </div>
            <button type="button" class="product-gallery__thumb-arrow" data-thumbs-next aria-label="{{ 'general.next' | t }}">{% render 'icon', icon: 'chevron-right' %}</button>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ============ INFO / BUY BOX ============ {%- endcomment -%}
    <div class="product__info-wrapper">
      <div class="product__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'social_proof' -%}
              <div class="social-proof" {{ block.shopify_attributes }}>
                <div class="social-proof__avatars">
                  {%- for i in (1..3) -%}
                    {%- assign key = 'avatar_' | append: i -%}
                    {%- assign av = block.settings[key] -%}
                    <span class="social-proof__avatar">
                      {%- if av != blank -%}
                        {{ av | image_url: width: 100 | image_tag: loading: 'eager', alt: '' }}
                      {%- else -%}
                        <span class="social-proof__avatar-ph social-proof__avatar-ph--{{ i }}"></span>
                      {%- endif -%}
                      {% render 'icon', icon: 'check-badge' %}
                    </span>
                  {%- endfor -%}
                </div>
                <p class="social-proof__pill">
                  <strong>{{ block.settings.count | escape }} {{ block.settings.bold_text | escape }}</strong>
                  <span>{{ block.settings.text | escape }}</span>
                </p>
              </div>

            {%- when 'rating' -%}
              <div class="product-rating" {{ block.shopify_attributes }}>
                <span class="product-rating__stars" aria-hidden="true">
                  {%- for i in (1..5) -%}{% render 'icon', icon: 'star' %}{%- endfor -%}
                </span>
                <strong>{{ block.settings.text | escape }}</strong>
              </div>

            {%- when 'title' -%}
              <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

            {%- when 'price' -%}
              <div class="product__price" data-price {{ block.shopify_attributes }}>
                {% render 'price', variant: current_variant, badge_text: block.settings.badge_text %}
              </div>

            {%- when 'text' -%}
              <div class="product__text rte{% if block.settings.show_markers %} product__text--markers{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="variant-picker" data-variant-picker {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    <fieldset class="variant-picker__option">
                      <legend>{{ option.name | escape }}</legend>
                      <div class="variant-picker__values">
                        {%- for value in option.values -%}
                          <label class="variant-picker__pill">
                            <input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %} data-option-index="{{ forloop.parentloop.index0 }}">
                            <span>{{ value | escape }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                  <script type="application/json" data-variants>{{ product.variants | json }}</script>
                </div>
              {%- endunless -%}

            {%- when 'low_stock' -%}
              <div class="low-stock" {{ block.shopify_attributes }}>
                <span class="low-stock__dot" aria-hidden="true"></span>
                <span>{{ block.settings.text | escape }}</span>
              </div>

            {%- when 'quantity_breaks' -%}
              <div class="quantity-breaks" data-quantity-breaks {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <div class="quantity-breaks__heading"><span>{{ block.settings.heading | escape }}</span></div>
                {%- endif -%}
                {%- for i in (1..3) -%}
                  {%- liquid
                    assign qk = 'qty_' | append: i
                    assign lk = 'label_' | append: i
                    assign ck = 'caption_' | append: i
                    assign dk = 'discount_' | append: i
                    assign bk = 'badge_' | append: i
                    assign qty = block.settings[qk]
                    assign discount = block.settings[dk]
                    assign line_price = current_variant.price | times: qty
                    assign keep = 100 | minus: discount
                    assign line_price = line_price | times: keep | divided_by: 100
                    assign line_compare = current_variant.compare_at_price | default: current_variant.price | times: qty
                  -%}
                  {%- if qty > 0 -%}
                    <label class="quantity-break{% if block.settings.default_option == i %} is-selected{% endif %}" data-qty="{{ qty }}" data-discount="{{ discount }}">
                      <input type="radio" name="qb-{{ section.id }}" value="{{ qty }}"{% if block.settings.default_option == i %} checked{% endif %}>
                      <span class="quantity-break__radio" aria-hidden="true"></span>
                      <span class="quantity-break__content">
                        <span class="quantity-break__label">{{ block.settings[lk] | escape }}</span>
                        <span class="quantity-break__caption">{{ block.settings[ck] | escape }}</span>
                      </span>
                      <span class="quantity-break__prices">
                        <span class="quantity-break__price" data-qb-price>{{ line_price | money }}</span>
                        {%- if line_compare > line_price -%}
                          <s class="quantity-break__compare" data-qb-compare>{{ line_compare | money }}</s>
                        {%- endif -%}
                      </span>
                      {%- if block.settings[bk] != blank -%}
                        <span class="quantity-break__badge">{{ block.settings[bk] | escape }}</span>
                      {%- endif -%}
                    </label>
                  {%- endif -%}
                {%- endfor -%}
              </div>

            {%- when 'upsell' -%}
              {%- if upsell != blank or request.design_mode or block.settings.show_placeholder -%}
                {%- liquid
                  assign up_variant = upsell.selected_or_first_available_variant
                  assign up_price = up_variant.price | default: 299
                  assign up_compare = up_variant.compare_at_price | default: 427
                -%}
                <label class="upsell" {{ block.shopify_attributes }}>
                  <span class="upsell__image">
                    {%- if settings.upsell_image != blank -%}
                      {{ settings.upsell_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                    {%- elsif upsell.featured_image != blank -%}
                      {{ upsell.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                    {%- else -%}
                      {% render 'priority-seal' %}
                    {%- endif -%}
                  </span>
                  <h3 class="upsell__title">{{ settings.upsell_title | default: upsell.title | escape }}</h3>
                  <span class="upsell__prices">
                    <span class="upsell__price">{{ up_price | money }}</span>
                    {%- if up_compare > up_price -%}<s class="upsell__compare">{{ up_compare | money }}</s>{%- endif -%}
                  </span>
                  <input type="checkbox" class="upsell__input" data-upsell-toggle data-variant-id="{{ up_variant.id }}"{% if settings.upsell_default_on %} checked{% endif %}>
                  <span class="upsell__switch" aria-hidden="true"></span>
                </label>
              {%- endif -%}

            {%- when 'buy_buttons' -%}
              <div class="product-form" {{ block.shopify_attributes }}>
                {%- form 'product', product, id: form_id, class: 'product-form__form', novalidate: 'novalidate', data-product-form: '' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>
                  <input type="hidden" name="quantity" value="1" data-quantity>
                  <div class="product-form__error" role="alert" hidden data-form-error></div>
                  <button
                    type="submit"
                    name="add"
                    class="button button--full product-form__submit"
                    data-add-button
                    {% unless current_variant.available %}disabled{% endunless %}
                  >
                    <span data-add-label>
                      {%- if current_variant.available == false -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- elsif block.settings.button_label != blank -%}
                        {{ block.settings.button_label | escape }}
                      {%- else -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- endif -%}
                    </span>
                    <span class="button__spinner" aria-hidden="true"></span>
                  </button>
                  {%- if block.settings.show_dynamic_checkout -%}
                    {{ form | payment_button }}
                  {%- endif -%}
                {%- endform -%}
              </div>

            {%- when 'secure_text' -%}
              <p class="secure-text" {{ block.shopify_attributes }}>{% render 'icon', icon: 'lock' %} {{ block.settings.text | escape }}</p>

            {%- when 'shipping_timeline' -%}
              <div
                class="shipping-timeline"
                data-shipping-timeline
                data-ready-min="{{ block.settings.ready_min }}"
                data-ready-max="{{ block.settings.ready_max }}"
                data-delivered-min="{{ block.settings.delivered_min }}"
                data-delivered-max="{{ block.settings.delivered_max }}"
                {{ block.shopify_attributes }}
              >
                <div class="shipping-timeline__step">
                  <span class="shipping-timeline__icon">{% render 'icon', icon: 'cart-add' %}</span>
                  <strong data-date="ordered">&nbsp;</strong>
                  <p>{{ block.settings.label_1 | escape }}</p>
                </div>
                <div class="shipping-timeline__step">
                  <span class="shipping-timeline__icon">{% render 'icon', icon: 'truck' %}</span>
                  <strong data-date="ready">&nbsp;</strong>
                  <p>{{ block.settings.label_2 | escape }}</p>
                </div>
                <div class="shipping-timeline__step">
                  <span class="shipping-timeline__icon">{% render 'icon', icon: 'gift' %}</span>
                  <strong data-date="delivered">&nbsp;</strong>
                  <p>{{ block.settings.label_3 | escape }}</p>
                </div>
              </div>

            {%- when 'review' -%}
              <div class="mini-review" {{ block.shopify_attributes }}>
                <span class="mini-review__avatar">
                  {%- if block.settings.avatar != blank -%}
                    {{ block.settings.avatar | image_url: width: 120 | image_tag: loading: 'lazy', alt: block.settings.author }}
                  {%- else -%}
                    <span class="mini-review__initial">{{ block.settings.author | slice: 0 }}</span>
                  {%- endif -%}
                </span>
                <div class="mini-review__body">
                  <p>{{ block.settings.text | escape }}</p>
                  <div class="mini-review__author">{{ block.settings.author | escape }} <span class="mini-review__stars" aria-label="5/5">{%- for i in (1..5) -%}{% render 'icon', icon: 'star' %}{%- endfor -%}</span></div>
                </div>
              </div>

            {%- when 'custom_liquid' -%}
              <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if section.settings.sticky_atc -%}
    <div class="sticky-atc" data-sticky-atc aria-hidden="true">
      <div class="sticky-atc__inner page-width">
        <div class="sticky-atc__product">
          <span class="sticky-atc__thumb">
            {%- if featured != blank -%}
              {{ featured.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            {%- elsif use_fallback -%}
              {%- assign base = fallback_images.first | split: '|' | first | strip | split: '.' | first -%}
              <img src="{{ base | append: '-thumb.jpg' | asset_url }}" width="240" height="240" alt="" loading="lazy">
            {%- else -%}
              {% render 'image-or-placeholder', alt: '' %}
            {%- endif -%}
          </span>
          <div>
            <h4 class="sticky-atc__title">{{ product.title | escape }}</h4>
            <div class="sticky-atc__price" data-sticky-price>
              {% render 'price', variant: current_variant, badge_text: section.settings.sticky_badge_text, compact: true %}
            </div>
          </div>
        </div>
        <button type="button" class="button sticky-atc__button" data-sticky-add {% unless current_variant.available %}disabled{% endunless %}>
          {{ 'products.product.add_to_cart_sentence' | t }}
        </button>
      </div>
    </div>
  {%- endif -%}

  <script type="application/json" data-product-json>
    {
      "id": {{ product.id | json }},
      "variants": {{ product.variants | json }},
      "currentVariant": {{ current_variant.id | json }}
    }
  </script>
</product-page>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    {
      "type": "textarea",
      "id": "fallback_images",
      "label": "Theme gallery images",
      "info": "Shown only while the product has no media of its own. One per line: asset file | alt text. Each file needs -750.jpg and -thumb.jpg versions in assets/."
    },
    { "type": "checkbox", "id": "sticky_atc", "label": "Show sticky add-to-cart bar", "default": true },
    { "type": "text", "id": "sticky_badge_text", "label": "Sticky bar badge text", "default": "SAVE [percent]%" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "social_proof",
      "name": "Orders social proof",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "avatar_1", "label": "Avatar 1" },
        { "type": "image_picker", "id": "avatar_2", "label": "Avatar 2" },
        { "type": "image_picker", "id": "avatar_3", "label": "Avatar 3" },
        { "type": "text", "id": "count", "label": "Count", "default": "99+" },
        { "type": "text", "id": "bold_text", "label": "Bold text", "default": "orders" },
        { "type": "text", "id": "text", "label": "Text", "default": "in the last 24h" }
      ]
    },
    {
      "type": "rating",
      "name": "Rating line",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Rated 4.8/5 By 1250+ Customers" }
      ]
    },
    { "type": "title", "name": "Title", "limit": 1 },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "badge_text", "label": "Sale badge text", "default": "SAVE [percent]%", "info": "[percent] is replaced with the discount" }
      ]
    },
    {
      "type": "text",
      "name": "Text / benefits",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p><strong>Timeless Persian Artistry</strong></p>" },
        { "type": "checkbox", "id": "show_markers", "label": "Show ◆ marker before each line", "default": true }
      ]
    },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    {
      "type": "low_stock",
      "name": "Low stock",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Low Stock" }
      ]
    },
    {
      "type": "quantity_breaks",
      "name": "Quantity breaks",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Displayed prices apply the discount below. Create a matching Shopify automatic volume discount (Discounts > Amount off products > minimum quantity) so the checkout price matches." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "LIMITED-TIME OFFER" },
        { "type": "range", "id": "default_option", "min": 1, "max": 3, "step": 1, "label": "Selected by default", "default": 2 },
        { "type": "header", "content": "Option 1" },
        { "type": "number", "id": "qty_1", "label": "Quantity", "default": 1 },
        { "type": "text", "id": "label_1", "label": "Label", "default": "Buy 1" },
        { "type": "text", "id": "caption_1", "label": "Caption", "default": "FREE SHIPPING" },
        { "type": "number", "id": "discount_1", "label": "Discount %", "default": 0 },
        { "type": "text", "id": "badge_1", "label": "Badge" },
        { "type": "header", "content": "Option 2" },
        { "type": "number", "id": "qty_2", "label": "Quantity", "default": 2 },
        { "type": "text", "id": "label_2", "label": "Label", "default": "Buy 2" },
        { "type": "text", "id": "caption_2", "label": "Caption", "default": "15% OFF + FREE SHIPPING" },
        { "type": "number", "id": "discount_2", "label": "Discount %", "default": 15 },
        { "type": "text", "id": "badge_2", "label": "Badge", "default": "Best Seller" },
        { "type": "header", "content": "Option 3" },
        { "type": "number", "id": "qty_3", "label": "Quantity (0 hides)", "default": 3 },
        { "type": "text", "id": "label_3", "label": "Label", "default": "Buy 3" },
        { "type": "text", "id": "caption_3", "label": "Caption", "default": "25% OFF + FREE SHIPPING" },
        { "type": "number", "id": "discount_3", "label": "Discount %", "default": 25 },
        { "type": "text", "id": "badge_3", "label": "Badge" }
      ]
    },
    {
      "type": "upsell",
      "name": "Priority processing",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Pick the product in Theme settings > Cart > Priority processing upsell." },
        { "type": "checkbox", "id": "show_placeholder", "label": "Show even when no product is picked", "default": false }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Add to cart button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label", "default": "ADD TO CART" },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": false }
      ]
    },
    {
      "type": "secure_text",
      "name": "Secure checkout text",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "All Transactions Are Secured & Encrypted" }
      ]
    },
    {
      "type": "shipping_timeline",
      "name": "Delivery timeline",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label_1", "label": "Step 1", "default": "Ordered" },
        { "type": "text", "id": "label_2", "label": "Step 2", "default": "Order Ready" },
        { "type": "text", "id": "label_3", "label": "Step 3", "default": "Delivered" },
        { "type": "number", "id": "ready_min", "label": "Ready from (days)", "default": 1 },
        { "type": "number", "id": "ready_max", "label": "Ready to (days)", "default": 2 },
        { "type": "number", "id": "delivered_min", "label": "Delivered from (days)", "default": 5 },
        { "type": "number", "id": "delivered_max", "label": "Delivered to (days)", "default": 7 }
      ]
    },
    {
      "type": "review",
      "name": "Mini review",
