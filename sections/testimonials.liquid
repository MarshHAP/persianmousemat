<div class="testimonials-section section-padding" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="section-title section-title--sm">{{ section.settings.title }}</h2>
    {%- endif -%}
    <div class="testimonials" data-slider>
      <ul class="testimonials__grid" role="list" data-slider-track>
        {%- for block in section.blocks -%}
          <li class="testimonial-card" {{ block.shopify_attributes }}>
            <div class="testimonial-card__media">
              {%- assign ph = forloop.index | modulo: 2 | plus: 1 | append: '' -%}
              {% render 'image-or-placeholder', image: block.settings.image, class: 'testimonial-card__img', alt: block.settings.title, sizes: '(min-width: 990px) 410px, 100vw', width: 800, placeholder: ph %}
              <span class="testimonial-card__quote">{% render 'icon', icon: 'quote' %}</span>
            </div>
            <div class="testimonial-card__body">
              <p class="testimonial-card__stars" aria-label="5/5">★★★★★</p>
              <h3 class="testimonial-card__title">{{ block.settings.title | escape }}</h3>
              <div class="testimonial-card__text">{{ block.settings.text }}</div>
              <div class="testimonial-card__author">
                {%- if block.settings.avatar != blank -%}
                  {{ block.settings.avatar | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
                {%- else -%}
                  <span class="testimonial-card__initial">{{ block.settings.author | slice: 0 }}</span>
                {%- endif -%}
                <strong>{{ block.settings.author | escape }}</strong>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
      <div class="slider-arrows">
        <button type="button" data-slider-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', icon: 'chevron-left' %}</button>
        <button type="button" data-slider-next aria-label="{{ 'general.next' | t }}">{% render 'icon', icon: 'chevron-right' %}</button>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "class": "section-testimonials",
  "max_blocks": 9,
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Loved By Desk Setups <strong>Worldwide</strong>", "info": "Bold text is shown in the accent color" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "title", "label": "Title", "default": "Absolutely Stunning" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share positive thoughts and feedback from your customer.</p>" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar" },
        { "type": "text", "id": "author", "label": "Author", "default": "Customer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }]
    }
  ]
}
{% endschema %}
