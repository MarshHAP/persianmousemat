{%- liquid
  assign accent = settings.color_accent | default: '#5bbc05'
  assign text = settings.color_text | default: '#121212'
  assign font = settings.type_font
  assign font_500 = font | font_modify: 'weight', '500'
  assign font_600 = font | font_modify: 'weight', '600'
  assign font_700 = font | font_modify: 'weight', '700'
  assign font_800 = font | font_modify: 'weight', '800'
  assign font_900 = font | font_modify: 'weight', '900'
  assign font_700_italic = font_700 | font_modify: 'style', 'italic'
  assign font_900_italic = font_900 | font_modify: 'style', 'italic'
-%}
<style>
  {{ font | font_face: font_display: 'swap' }}
  {{ font_500 | font_face: font_display: 'swap' }}
  {{ font_600 | font_face: font_display: 'swap' }}
  {{ font_700 | font_face: font_display: 'swap' }}
  {{ font_800 | font_face: font_display: 'swap' }}
  {{ font_900 | font_face: font_display: 'swap' }}
  {{ font_700_italic | font_face: font_display: 'swap' }}
  {{ font_900_italic | font_face: font_display: 'swap' }}

  :root {
    --accent: {{ accent }};
    --accent-rgb: {{ accent.red }}, {{ accent.green }}, {{ accent.blue }};
    --text: {{ text }};
    --text-rgb: {{ text.red }}, {{ text.green }}, {{ text.blue }};
    --bg: {{ settings.color_background | default: '#ffffff' }};
    --dark: {{ settings.color_dark | default: '#121212' }};
    --card: {{ settings.color_card | default: '#f5f5f5' }};
    --stars: {{ settings.color_stars | default: '#ffcc00' }};
    --dot: {{ settings.color_sale_dot | default: '#ff0000' }};
    --font: {{ font.family }}, {{ font.fallback_families }};
    --logo-w: {{ settings.logo_width | default: 160 }}px;
    --logo-w-m: {{ settings.logo_width_mobile | default: 110 }}px;
  }
</style>
