{%- assign d = days | default: 90 -%}
<svg class="guarantee-seal" viewBox="0 0 200 200" role="img" aria-label="{{ d }} days money back guarantee">
  <defs>
    <linearGradient id="gs-g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#8fd13f"/><stop offset="1" stop-color="#4a9a06"/></linearGradient>
    <path id="gs-top" d="M45 100a55 55 0 0 1 110 0"/>
    <path id="gs-bot" d="M42 100a58 58 0 0 0 116 0"/>
    <radialGradient id="gs-shadow"><stop offset="0" stop-color="#000" stop-opacity=".25"/><stop offset="1" stop-color="#000" stop-opacity="0"/></radialGradient>
  </defs>
  <ellipse cx="100" cy="190" rx="70" ry="6" fill="url(#gs-shadow)"/>
  {%- comment -%} scalloped rosette {%- endcomment -%}
  <g fill="url(#gs-g)">
    {%- for i in (0..23) -%}
      <circle cx="100" cy="18" r="14" transform="rotate({{ i | times: 15 }} 100 100)"/>
    {%- endfor -%}
    <circle cx="100" cy="100" r="80"/>
  </g>
  <circle cx="100" cy="100" r="66" fill="none" stroke="#fff" stroke-width="3"/>
  <text style="font-family: var(--font)" font-weight="800" font-size="17" fill="#fff" letter-spacing="1"><textPath href="#gs-top" startOffset="50%" text-anchor="middle">MONEY BACK</textPath></text>
  <text style="font-family: var(--font)" font-weight="800" font-size="15" fill="#fff" letter-spacing="1" dy="14"><textPath href="#gs-bot" startOffset="50%" text-anchor="middle">GUARANTEE</textPath></text>
  <rect x="18" y="80" width="164" height="42" fill="#fff"/>
  <rect x="22" y="84" width="156" height="34" fill="#4a9a06"/>
  <text x="100" y="112" style="font-family: var(--font)" font-weight="900" font-size="30" fill="#fff" text-anchor="middle">{{ d }} DAYS</text>
  <text x="100" y="72" style="font-family: var(--font)" font-size="12" fill="#fff" text-anchor="middle">★ ★ ★</text>
  <text x="100" y="140" style="font-family: var(--font)" font-size="12" fill="#fff" text-anchor="middle">★ ★ ★</text>
</svg>
