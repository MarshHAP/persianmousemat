<nav class="pagination" aria-label="Pagination">
  {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr; {{ 'general.previous' | t }}</a>{%- endif -%}
  {%- for part in paginate.parts -%}
    {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span{% if part.title == paginate.current_page %} aria-current="page" style="font-weight:700;color:var(--accent)"{% endif %}>{{ part.title }}</span>{%- endif -%}
  {%- endfor -%}
  {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ 'general.next' | t }} &rarr;</a>{%- endif -%}
</nav>
