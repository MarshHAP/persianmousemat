<a href="{{ card_product.url }}" class="card">
  <div class="card__media">
    {%- if card_product.featured_media -%}
      {{ card_product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '300, 450, 600', alt: card_product.title }}
    {%- else -%}
      {% render 'image-or-placeholder', alt: card_product.title %}
    {%- endif -%}
  </div>
  <h3 class="card__title">{{ card_product.title | escape }}</h3>
  {% render 'price', variant: card_product.selected_or_first_available_variant %}
</a>
