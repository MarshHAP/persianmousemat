<div class="main-page">
  <div class="page-width" style="max-width: 480px;">
    <h1 class="main-page__title">{{ 'customer.register' | t }}</h1>
    {%- form 'create_customer' -%}
      {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <input class="form-field" type="text" name="customer[first_name]" placeholder="{{ 'customer.first_name' | t }}" autocomplete="given-name">
      <input class="form-field" type="text" name="customer[last_name]" placeholder="{{ 'customer.last_name' | t }}" autocomplete="family-name">
      <input class="form-field" type="email" name="customer[email]" placeholder="{{ 'customer.email' | t }}" autocomplete="email" required>
      <input class="form-field" type="password" name="customer[password]" placeholder="{{ 'customer.password' | t }}" autocomplete="new-password" required>
      <button class="button button--full">{{ 'customer.register' | t }}</button>
    {%- endform -%}
  </div>
</div>
