{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Gift card — {{ shop.name }}</title>
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body>
    <main class="main-page main-page--center">
      <div class="page-width" style="max-width: 520px;">
        <h1 class="main-page__title">{{ shop.name }}</h1>
        <p style="font-size: 40px; font-weight: 900; color: var(--accent);">{{ gift_card.balance | money }}</p>
        {%- if gift_card.enabled == false or gift_card.expired -%}<p class="form-message form-message--error">This gift card is no longer valid.</p>{%- endif -%}
        <p style="margin: 20px 0; font-size: 22px; font-weight: 700; letter-spacing: 3px;">{{ gift_card.code | format_code }}</p>
        <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}" style="display:flex;justify-content:center;margin:20px 0;"></div>
        <a href="{{ shop.url }}" class="button">{{ 'general.continue_shopping' | t }}</a>
        {%- if gift_card.pass_url -%}<p style="margin-top: 20px;"><a href="{{ gift_card.pass_url }}">Add to Apple Wallet</a></p>{%- endif -%}
      </div>
    </main>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
